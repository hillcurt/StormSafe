# StormSafe settings. Copy to .env (git-ignored) and fill in the blanks.

# Site config: PRIVATE (ADR 0004). Never commit real values anywhere in this repo.
# The site must be within GOES-19 Geostationary Lightning Mapper coverage.
STORMSAFE_SITE_LAT=
STORMSAFE_SITE_LON=
STORMSAFE_SITE_TIMEZONE=

# HUMAN-ONLY VALUES from docs/problem-spec.md. Changing any requires a new ADR.
# Label: a strike within this radius in the next forecast horizon
STORMSAFE_LABEL_RADIUS_MILES=10
STORMSAFE_FORECAST_HORIZON_MINUTES=60
# Operating rule: the pool closes for this long after a strike within the radius
STORMSAFE_CLOSURE_DURATION_MINUTES=30
# Operating hours, site local time
STORMSAFE_OPERATING_HOURS_START=10:00
STORMSAFE_OPERATING_HOURS_END=18:00

# Local data root
STORMSAFE_DATA_DIR=data
